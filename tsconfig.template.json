{
	"compilerOptions": {
		"module": "es2022",
		"target": "es2024",
		"lib": ["es2024", "esnext.iterator"],
		"moduleResolution": "bundler",
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"strict": true,
		"noImplicitAny": false,
		"noImplicitThis": false,
		"strictNullChecks": false,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"paths": {
			"pebble/*": ["__MODDABLE__/typings/pebble/*"],
			"commodetto/*": ["__MODDABLE__/typings/commodetto/*"],
			"piu/*": ["__MODDABLE__/typings/piu/*"],
			"pins/*": ["__MODDABLE__/typings/pins/*"],
			"mc/*": ["__MODDABLE__/typings/mc/*"],
			"text/*": ["__MODDABLE__/typings/text/*"],
			"dns/*": ["__MODDABLE__/typings/dns/*"],
			"embedded:io/*": ["__MODDABLE__/typings/embedded_io/*"],
			"embedded:network/*": ["__MODDABLE__/typings/embedded_network/*"],
			"embedded:provider/*": ["__MODDABLE__/typings/embedded_provider/*"],
			"@thimoteus/alst_core/*": ["./node_modules/@thimoteus/alst_core/types/*"],
			"*": [
				"__MODDABLE__/typings/*",
				"__MODDABLE__/typings/ble/*",
				"__MODDABLE__/typings/web/*"
			]
		},
		"types": [
			"__MODDABLE__/xs/includes/xs",
			"__MODDABLE__/typings/global",
			"__MODDABLE__/typings/pebble/global"
		]
	},
	"include": ["src/embeddedjs/**/*.ts"]
}
